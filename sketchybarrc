#!/bin/bash
export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
PLUGIN_DIR="$CONFIG_DIR/plugins"

sketchybar --bar position=top height=30 notch_display_height=33 \
  color=0x33242426 blur_radius=30 margin=0 corner_radius=0 padding_left=0 padding_right=0 \
  display=all sticky=on topmost=on shadow=off

sketchybar --default \
  icon.font=".AppleSystemUIFont:Bold:13.0" label.font=".AppleSystemUIFont:Bold:13.0" \
  icon.color=0xffa1a1aa label.color=0xfff5f5f7 \
  padding_left=6 padding_right=6 \
  icon.padding_left=4 icon.padding_right=4 \
  label.padding_left=4 label.padding_right=4 \
  background.height=24 background.corner_radius=6

sketchybar --add item apple left \
  --set apple padding_left=14 icon="" icon.font=".AppleSystemUIFont:Regular:21.0" \
    icon.color=0xfff5f5f7 label.drawing=off

# Discover native Spaces across the currently connected displays.
sketchybar --add item spaces_observer left \
  --set spaces_observer drawing=off updates=on update_freq=3 \
    script="$PLUGIN_DIR/sync_spaces.sh" \
  --subscribe spaces_observer space_change display_change system_woke

sketchybar --add item front_app left \
  --set front_app icon.drawing=on icon.width=24 icon.background.drawing=on \
    icon.background.image.scale=0.65 \
    label="" label.max_chars=50 padding_left=14 \
    update_freq=2 script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched space_change display_change system_woke

sketchybar --add item clock right \
  --set clock padding_right=14 icon.drawing=off label.font=".AppleSystemUIFont:Semibold:13.0" \
    update_freq=15 script="$PLUGIN_DIR/clock.sh"

sketchybar --add event now_playing_change \
  --add item now_playing right \
  --set now_playing drawing=off updates=on icon="♪" padding_left=12 \
    icon.font=".AppleSystemUIFont:Semibold:13.0" label.font=".AppleSystemUIFont:Semibold:13.0" \
    label.max_chars=32 scroll_texts=off update_freq=10 \
    script="$PLUGIN_DIR/now_playing.sh" \
  --subscribe now_playing now_playing_change system_woke

for metric in cpu gpu; do
  case "$metric" in cpu) glyph="" ;; gpu) glyph="󰢮" ;; esac
  sketchybar --add graph "$metric" right 52 \
    --set "$metric" icon="$glyph" label.drawing=off padding_left=3 padding_right=3 \
      icon.font="JetBrainsMono Nerd Font:SemiBold:14.0" icon.color=0xffc7c7cc \
      icon.width=24 icon.align=center icon.y_offset=0 \
      icon.padding_left=2 icon.padding_right=2 \
      graph.color=0xffc7c7cc graph.fill_color=0x33c7c7cc graph.line_width=1.0 \
      background.drawing=on background.color=0x00000000 background.height=26
done
sketchybar --set cpu update_freq=5 script="$PLUGIN_DIR/compact_usage.sh" \
  --subscribe cpu system_woke \
  --reorder clock gpu cpu now_playing

sketchybar --update

if ! pgrep -f '[s]ketchybar-now-playing daemon --event now_playing_change' >/dev/null 2>&1; then
  "$CONFIG_DIR/bin/sketchybar-now-playing" daemon --event now_playing_change \
    >>/private/tmp/sketchybar-now-playing.log 2>&1 &
fi

# Reveal the always-visible native menu bar when the pointer reaches the top.
TOGGLE_BIN="$CONFIG_DIR/bin/sketchybar-toggle"
if [ ! -x "$TOGGLE_BIN" ]; then
  TOGGLE_BIN="$(command -v sketchybar-toggle || true)"
fi
if [ -n "$TOGGLE_BIN" ]; then
  pkill -x sketchybar-toggle 2>/dev/null || true
  "$TOGGLE_BIN" --trigger-zone 30 --menu-bar-height 33 --debounce 300 &
fi
