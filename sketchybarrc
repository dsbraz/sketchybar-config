#!/bin/bash
export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

sketchybar --bar position=top height=32 notch_display_height=32 \
  color=0x00000000 blur_radius=0 margin=0 corner_radius=0 padding_left=8 padding_right=0 \
  display=all sticky=on topmost=on shadow=off

sketchybar --default \
  icon.font=".AppleSystemUIFont:Bold:13.0" label.font=".AppleSystemUIFont:Bold:13.0" \
  icon.color=0xffa1a1aa label.color=0xfff5f5f7 \
  padding_left=6 padding_right=6 y_offset=-2 \
  icon.padding_left=4 icon.padding_right=4 \
  label.padding_left=4 label.padding_right=4 \
  background.height=24 background.corner_radius=6

sketchybar --add item apple left \
  --set apple padding_left=6 icon="" icon.font=".AppleSystemUIFont:Regular:21.0" \
    icon.color=0xfff5f5f7 label.drawing=off

# Discover native Spaces across the currently connected displays.
sketchybar --add item spaces_observer left \
  --set spaces_observer drawing=off updates=on update_freq=0

sketchybar --add item front_app left \
  --set front_app icon.drawing=on icon.width=24 icon.background.drawing=on \
    icon.background.image.scale=0.65 \
    label="" label.max_chars=50 label.padding_right=20 scroll_texts=on \
    padding_left=14 padding_right=12 \
    updates=off update_freq=0

# Cover both the left-side content and the active application's native menus.
sketchybar --add item left_edge left \
  --set left_edge width=0 padding_left=0 padding_right=0 \
    icon.drawing=off label.drawing=off \
  --move left_edge before apple \
  --add item menu_cover_end left \
  --set menu_cover_end width=0 padding_left=0 padding_right=0 \
    icon="" icon.drawing=on icon.width=0 icon.padding_left=0 icon.padding_right=0 \
    label.drawing=off \
  --move menu_cover_end after left_edge \
  --add bracket left_backdrop left_edge front_app menu_cover_end \
  --set left_backdrop background.color=0xff242426 background.drawing=on y_offset=-2 \
    background.height=28 background.corner_radius=8 \
    background.padding_left=0 background.padding_right=8 blur_radius=0 shadow=off

sketchybar --update

# Reveal the always-visible native menu bar when the pointer reaches the top.
if [ ! -x "$CONFIG_DIR/bin/SketchyBar Helper.app/Contents/MacOS/sketchybar-toggle" ]; then
  echo "Build the native helper first: bash $CONFIG_DIR/build-toggle.sh" >&2
  exit 1
fi
pkill -x sketchybar-toggle 2>/dev/null || true
# Wait for the previous helper to release its event port and restore visibility.
for attempt in {1..30}; do
  pgrep -x sketchybar-toggle >/dev/null || break
  sleep 0.1
done
/usr/bin/open -g "$CONFIG_DIR/bin/SketchyBar Helper.app" \
  --env SKETCHYBAR_TRANSITION=smooth-slide --env SKETCHYBAR_NATIVE_MENU=1 \
  --stdout /private/tmp/sketchybar-toggle.log --stderr /private/tmp/sketchybar-toggle.log \
  --args --trigger-zone 30 --menu-bar-height 33 --debounce 150
